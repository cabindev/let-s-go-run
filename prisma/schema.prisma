generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum EventStatus {
  OPEN
  CLOSED
  CANCELLED
}

/** วิ่งในงาน (มีสถานที่จริง) หรือ วิ่งที่ไหนก็ได้ (virtual) */
enum EventType {
  ONSITE
  VIRTUAL
}

/** สถานะรับเสื้อ/ของที่ระลึกหน้างาน — ยืนยันผ่านระบบสแกน QR แยกต่างหาก */
enum PickupStatus {
  PENDING    // ยังไม่รับ
  PICKED_UP  // รับที่บูธแล้ว
  SHIPPED    // ส่งไปรษณีย์แทน
}

enum RegistrationStatus {
  PENDING   // ลงทะเบียนแล้ว รอชำระเงิน
  PAID      // ยืนยันการชำระเงินแล้ว (ผ่าน Stripe เท่านั้น)
  EXPIRED   // ไม่ชำระเงินภายในเวลาที่กำหนด ระบบคืนที่นั่งอัตโนมัติ
  CANCELLED // ผู้สมัครยกเลิกเอง หรือผู้ดูแลระบบยกเลิกให้
}

// เกณฑ์ปลดล็อกความสำเร็จ
enum AchievementType {
  EVENT_COUNT    // เข้าร่วมกิจกรรมครบ N ครั้ง
  TOTAL_DISTANCE // ระยะทางสะสมครบ N กม.
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  image         String?
  role          Role      @default(USER)
  dateOfBirth   DateTime?
  phone         String?
  bio           String?   @db.Text

  // ลืมรหัสผ่าน — เก็บ hash ของ token (ไม่เก็บ token ดิบ เหมือนหลัก practice ของ password)
  // null = ไม่มีคำขอรีเซ็ตค้างอยู่
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  // Stats (คำนวณใหม่ทุกครั้งที่มีการยืนยันการชำระเงิน)
  totalDistance Float     @default(0)

  registrations Registration[]
  achievements  UserAchievement[]

  // ร้านค้า — ตะกร้ามีได้คนละใบเดียว ออเดอร์มีได้หลายใบ
  cart          Cart?
  orders        Order[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Event {
  id              String      @id @default(cuid())
  title           String
  description     String      @db.Text
  date            DateTime                  // วันและ "เวลาเริ่ม" ของกิจกรรม
  endDate         DateTime?                 // วัน/เวลาสิ้นสุด (ถ้ามี)
  location        String
  province        String?                   // ใช้กรองในหน้าแรก
  organizer       String?                   // "จัดโดย ..."
  type            EventType   @default(ONSITE)

  // ค่าเริ่มต้นของงาน — ใช้เมื่อยังไม่ได้สร้างประเภทการแข่งขัน
  distance        Float
  price           Float
  maxParticipants Int?                      // จำนวนรับสมัครรวมทั้งงาน (null = ไม่จำกัด)

  // ช่วงเปิดรับสมัคร (null = ยึดตามสถานะและวันจัดงาน)
  registerOpenAt  DateTime?
  registerCloseAt DateTime?

  image           String?                   // รูปปก (แบนเนอร์)
  status          EventStatus @default(OPEN)

  // ตัวนับ BIB ล่าสุดของงานนี้ — เพิ่มค่าแบบ atomic (increment) ตอนออกเลข กันเลขชนกันแม้มีคน
  // ยืนยันการชำระเงินพร้อมกันหลายคน (เผื่อเกิดช่องว่างในลำดับได้ถ้ามีรายการที่ออกเลขแล้วแต่บันทึกไม่สำเร็จ)
  bibCounter      Int         @default(0)

  // ข้อมูลเสริมที่พบบนหน้างานจริง
  rewards         String?     @db.Text       // สิ่งที่ผู้สมัครจะได้รับ (เสื้อ/เหรียญ/ของที่ระลึก)
  contactUrl      String?                    // ลิงก์ติดตามรายละเอียด (เพจ/เว็บผู้จัด)
  announceAt      DateTime?                  // วันประกาศผล

  // เปิด/ปิดฟิลด์ข้อมูลเสริมในฟอร์มสมัคร — แต่ละงานเลือกเก็บได้ไม่เหมือนกัน (ค่าเริ่มต้นปิดหมด
  // เพื่อไม่กระทบงานเก่า)
  collectGender                Boolean @default(false)
  collectBloodType             Boolean @default(false)
  collectNationalId            Boolean @default(false)
  collectPreviousParticipation Boolean @default(false)
  collectDateOfBirth           Boolean @default(false)

  // ข้อความแจ้งเตือน PDPA ที่แสดงในฟอร์มสมัคร — แต่ละงานแก้ไขเองได้ (ว่าง = ใช้ข้อความกลางแทน)
  pdpaNotice String? @db.Text

  // เปิดให้ผู้สมัครเลือกรับทางไปรษณีย์แทนการมารับที่งาน (+ค่าส่ง SHIPPING_FEE) ตั้งแต่ตอนสมัคร
  offerShipping Boolean @default(false)

  images        EventImage[]
  categories    RaceCategory[]
  registrations Registration[]
  products      Product[]              // สินค้าในร้านที่ผูกกับงานนี้ (เช่น เสื้อของงาน) — ไม่ผูกก็ได้
  inviteCodes   InviteCode[]           // โควตาสิทธิพิเศษ (สปอนเซอร์/แขกผู้จัด) — อยู่นอก maxParticipants

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, date])
  @@index([province])
}

/** หมวดของรูปประกอบ — ใช้จัดกลุ่มทั้งตอนอัปโหลดและตอนแสดงผล */
enum ImageCategory {
  SHIRT       // เสื้อ (แนะนำหน้า–หลัง)
  MEDAL       // เหรียญ
  ROUTE       // แผนที่เส้นทาง
  SIZE_GUIDE  // ตารางไซส์
  ATMOSPHERE  // บรรยากาศงาน
  OTHER       // อื่น ๆ
}

/**
 * รูปประกอบของงาน (นอกเหนือจากรูปปก)
 * แยกเป็นตารางเพื่อให้เพิ่ม/ลบ/เรียงลำดับได้ โดยไม่ต้องเก็บ HTML จากผู้ใช้
 */
model EventImage {
  id        String        @id @default(cuid())
  eventId   String
  url       String
  caption   String?
  category  ImageCategory @default(OTHER)
  sortOrder Int           @default(0)

  // ขนาดจริงของไฟล์ — ใช้จองพื้นที่ก่อนรูปโหลด กันหน้ากระโดด
  width     Int?
  height    Int?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([eventId, category])
}

/** ประเภทการแข่งขันของงานหนึ่ง ๆ เช่น "Early Bird 10 กม." / "Fuji Solo" */
model RaceCategory {
  id        String  @id @default(cuid())
  eventId   String
  name      String
  distance  Float
  price     Float
  maxSlots  Int?                  // จำนวนรับของประเภทนี้ (null = ไม่จำกัด)
  sortOrder Int     @default(0)

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model Registration {
  id           String             @id @default(cuid())
  userId       String
  eventId      String
  categoryId   String?                      // ประเภทที่เลือก (null = ใช้ค่าของงาน)
  bib          String?                      // ออกให้อัตโนมัติเมื่อยืนยันการชำระเงิน
  status       RegistrationStatus @default(PENDING)
  note         String?            @db.Text  // ข้อความจากระบบ เช่น เหตุผลที่หมดเวลาชำระอัตโนมัติ
  registeredAt DateTime           @default(now())
  paidAt       DateTime?

  // ร่องรอยการจ่ายผ่าน Stripe — ไว้ตรวจสอบ/reconcile ย้อนหลังกับ Stripe Dashboard เท่านั้น
  // ไม่มีผลต่อ business logic ใดๆ (null = ยังไม่เคยเริ่ม checkout)
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  paymentMethod         String? // "card" | "promptpay" — ค่าจริงที่ใช้จ่ายตอนสำเร็จ
  receiptUrl            String? @db.Text // ใบเสร็จที่ Stripe ออกให้อัตโนมัติ (Charge.receipt_url) — null ถ้าเป็นงานฟรี

  // กำหนดเวลาที่ต้องชำระเงินให้เสร็จ — เลยเวลานี้ระบบคืนที่นั่งอัตโนมัติ
  // null = ไม่มีกำหนด (จ่ายแล้ว)
  expiresAt    DateTime?

  // ข้อมูลผู้สมัคร ณ เวลาที่สมัคร (แยกจากโปรไฟล์ เพราะอาจสมัครแทนคนอื่น/เปลี่ยนภายหลัง)
  fullName       String?
  phone          String?
  shirtSize      String?
  address        String?  @db.Text
  emergencyName  String?
  emergencyPhone String?

  // ฟิลด์เสริม — มีค่าเฉพาะงานที่เปิดเก็บ (ดู Event.collect*) ที่เหลือเป็น null เสมอ
  gender                String?  // "MALE" | "FEMALE" (ค่าเก่า "LGBTQ" อาจยังพบได้ในเรคคอร์ดก่อนหน้า)
  bloodType             String?  // "O" | "A" | "B" | "AB"
  nationalId            String?  // เลขบัตรประชาชน 13 หลัก — ใช้เพื่อสิทธิ์ประกันอุบัติเหตุ
  hasParticipatedBefore Boolean?
  hasMedicalCondition    Boolean? // มีโรคประจำตัวหรือไม่ — มีค่าเฉพาะงานที่เปิด Event.collectBloodType
  medicalConditionDetail String?  @db.Text // รายละเอียดโรคประจำตัว — มีค่าเฉพาะเมื่อ hasMedicalCondition = true

  // เวลาที่ผู้สมัครกดยินยอมข้อความ PDPA — ใช้เป็นหลักฐานการยินยอมย้อนหลัง
  pdpaConsentAt DateTime?

  /**
   * ตั้งค่าเมื่อ Stripe แจ้งว่าจ่ายเงินสำเร็จ แต่ใบสมัครไม่อยู่ในสถานะที่รับเงินได้แล้ว
   * (หมดเวลาชำระ หรือถูกยกเลิก — ที่นั่งถูกคืนให้คนอื่นไปแล้ว)
   *
   * เงินเข้าจริงแต่ผู้สมัครไม่ได้ที่นั่ง ห้ามปล่อยเงียบ ต้องมีคนตามเรื่อง
   * (กติกาเดียวกับ Order.paymentIssueAt ของฝั่งร้านค้า)
   */
  paymentIssueAt DateTime?

  // วิธีรับของที่เลือกไว้ตอนสมัคร (มีค่าเฉพาะงานที่เปิด Event.offerShipping)
  // "PICKUP" = มารับเองที่งาน (สแกน QR หน้างาน) / "SHIPPING" = ส่งไปรษณีย์ (+ค่าส่ง)
  deliveryMethod String?

  // รับเสื้อ/ของที่ระลึก — ยืนยันผ่านระบบสแกน QR หน้างานแยกต่างหาก (ดู CHECKIN_API_SECRET)
  pickupStatus       PickupStatus @default(PENDING)
  pickupAt           DateTime?
  shippingTrackingNo String?
  pickupSignatureUrl String?  @db.Text // ลายเซ็นนิ้วบนจอตอนรับที่บูธ — เป็นหลักฐานยืนยัน

  /**
   * โค้ดสิทธิพิเศษที่ใช้สมัคร (null = สมัครแบบปกติ เสียเงินเอง)
   *
   * มีค่าเมื่อไหร่ ที่นั่งใบนี้จะ **ไม่ถูกนับในโควตาสาธารณะ** ของงาน (ดู publicSeatWhere())
   * เพราะสิทธิพิเศษถูกออกแบบให้อยู่นอกจำนวนรับสมัครที่ประกาศไว้
   *
   * `inviteGroupName` เก็บซ้ำโดยตั้งใจ (snapshot แบบเดียวกับ OrderItem) — ลบโค้ดทิ้งแล้ว
   * ยังต้องตอบได้ว่าที่นั่งฟรีใบนี้มาจากกลุ่มไหน
   */
  inviteCodeId    String?
  inviteGroupName String?

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category    RaceCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inviteCode  InviteCode?        @relation(fields: [inviteCodeId], references: [id], onDelete: SetNull)
  submissions RunSubmission[]

  @@unique([userId, eventId])
  @@unique([eventId, bib])
  @@index([userId])
  @@index([eventId])
  @@index([categoryId])
  @@index([status])
  @@index([status, expiresAt])
  @@index([paymentIssueAt])
  @@index([inviteCodeId])
  @@index([eventId, inviteCodeId])
}

/**
 * โค้ดสิทธิพิเศษของงาน — สปอนเซอร์, แขกผู้จัดงาน, ทีมงาน
 *
 * ที่นั่งจากโค้ดอยู่ **นอกโควตารับสมัครที่ประกาศไว้** ทั้งยอดรวมของงานและโควตารายรุ่น
 * (รับ 400 + โค้ด 40 = 440 คนจริง) แอดมินเป็นคนประเมินของ/เสื้อ/ประกันจากยอดรวมนั้นเอง
 * ส่วนเกินมีเพดานตายตัวเสมอ = จำนวนสิทธิ์ที่ออกไว้ ไม่มีทางบานปลายเกินนั้น
 *
 * รองรับสองรูปแบบด้วยตารางเดียว ต่างกันแค่ maxUses:
 *   - โค้ดเดียวแจกทั้งกลุ่ม → 1 แถว maxUses = 20
 *   - โค้ดใช้ครั้งเดียวรายคน → 20 แถว maxUses = 1 (groupName เดียวกัน)
 */
model InviteCode {
  id        String  @id @default(cuid())
  eventId   String
  code      String  @unique          // ระบบสุ่มให้ ไม่ให้แอดมินตั้งเอง (โค้ดที่คนตั้งเองเดาง่าย)
  groupName String                   // "วิริยะประกันภัย" / "แขกผู้จัดงาน" — ใช้จัดกลุ่มและรายงาน

  /**
   * ส่วนลดเป็นเปอร์เซ็นต์เท่านั้น (100 = ฟรี)
   *
   * ไม่รองรับลดเป็นบาทโดยตั้งใจ — แต่ละรุ่นราคาไม่เท่ากัน ลดเป็นบาทเท่ากันจะกลายเป็น
   * เปอร์เซ็นต์ไม่เท่ากัน (฿100 จาก ฿400 = 25% แต่จาก ฿700 = 14%) ซึ่งอธิบายยากเมื่อ
   * คนในกลุ่มเดียวกันเทียบตัวเลขกัน
   */
  discountPercent Int @default(100)

  maxUses   Int       @default(1)
  usedCount Int       @default(0)     // เพิ่มแบบมีเงื่อนไขในทรานแซกชัน กันแย่งสิทธิ์พร้อมกัน
  expiresAt DateTime?                 // null = ไม่มีกำหนด (ยังติดวันปิดรับสมัครของงานอยู่ดี)
  active    Boolean   @default(true)  // ปิดชั่วคราวได้โดยไม่ต้องลบ (ลบแล้วเสียประวัติ)
  note      String?   @db.Text

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([eventId, groupName])
}

/**
 * ผลวิ่งที่ผู้สมัครส่งเข้ามา — ใช้เฉพาะงานประเภท VIRTUAL
 * งานวิ่งในงาน (ONSITE) ไม่ต้องส่งผล ระบบนับระยะให้เมื่อกิจกรรมจบและยืนยันการชำระเงินแล้ว
 * ส่งแล้วขึ้นทันที ผู้ดูแลระบบลบออกภายหลังได้ถ้าพบว่าไม่ถูกต้อง
 */
model RunSubmission {
  id             String   @id @default(cuid())
  registrationId String
  distance       Float                 // ระยะทางของการวิ่งครั้งนี้ (กม.)
  runDate        DateTime              // วันที่วิ่งจริง
  evidenceUrl    String?               // ภาพจากนาฬิกา/แอปวิ่ง
  note           String?
  createdAt      DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([runDate])
}

model Achievement {
  id          String          @id @default(cuid())
  name        String
  description String?
  icon        String?
  type        AchievementType @default(EVENT_COUNT)
  threshold   Float           @default(1)   // ค่าที่ต้องถึงจึงปลดล็อก

  users       UserAchievement[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ร้านค้า (Shop)
//
// แยกจากระบบสมัครงานวิ่งโดยสิ้นเชิง — ไม่แตะ Registration เลย เพราะ Registration
// ถูกออกแบบเป็น "1 คน 1 งาน" (@@unique([userId, eventId])) จึงมีหลายชิ้น/หลายไซส์/
// มีจำนวนไม่ได้ ส่วนตรงนี้ใช้ User / Stripe / ระบบ auth ร่วมกับของเดิม
// ─────────────────────────────────────────────────────────────────────────────

/** สินค้าพร้อมส่ง (ตัดสต็อกจริง) หรือ พรีออเดอร์ (ผลิตหลังปิดรอบ) — คนละรอบจัดส่ง จึงแยกออเดอร์กัน */
enum ProductType {
  STOCK
  PREORDER
}

enum ProductStatus {
  DRAFT   // ยังไม่เผยแพร่ — เห็นเฉพาะแอดมิน
  ACTIVE  // ขายอยู่
  HIDDEN  // ซ่อนชั่วคราว (ของเก่าที่ขายไปแล้วยังอ้างอิงได้)
}

enum OrderStatus {
  PENDING    // สั่งแล้ว รอชำระเงิน (จองสต็อกไว้แล้ว)
  PAID       // ชำระเงินแล้ว รอจัดเตรียม
  PREPARING  // กำลังจัดเตรียม/รอผลิต (พรีออเดอร์)
  SHIPPED    // จัดส่งแล้ว (มีเลขพัสดุ)
  COMPLETED  // ผู้ซื้อรับของแล้ว
  CANCELLED  // ยกเลิก — คืนสต็อกแล้ว
  EXPIRED    // ไม่ชำระเงินตามกำหนด ระบบคืนสต็อกอัตโนมัติ
  REFUNDED   // คืนเงินแล้ว
}

/** วิธีรับของของออเดอร์ร้านค้า (แยกจาก Registration.deliveryMethod ที่เป็น String) */
enum ShopDelivery {
  PICKUP    // มารับเอง
  SHIPPING  // ส่งไปรษณีย์ (+ค่าส่ง)
}

/**
 * หมวดรูปสินค้า — คนซื้อของออนไลน์ตัดสินใจจากรูปเป็นหลัก จึงแยกหมวดให้ชัด
 * FRONT กับ BACK บังคับต้องมีก่อนเปิดขาย (ดู REQUIRED_PRODUCT_IMAGE_GROUPS)
 */
enum ProductImageCategory {
  FRONT       // ด้านหน้า
  BACK        // ด้านหลัง
  MODEL       // ใส่จริงบนนายแบบ/นางแบบ
  DETAIL      // รายละเอียดเนื้อผ้า/งานพิมพ์
  SIZE_GUIDE  // ตารางไซส์
  OTHER
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique          // ใช้เป็น URL /shop/[slug]
  name        String
  description String        @db.Text
  type        ProductType   @default(STOCK)
  status      ProductStatus @default(DRAFT)
  price       Float                          // ราคาตั้งต้น — variant override ได้

  // ผูกกับงานวิ่ง (ไม่บังคับ) — null = สินค้าทั่วไปที่ไม่เกี่ยวกับงานไหน
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // เฉพาะสินค้าพรีออเดอร์
  preorderCloseAt DateTime?                  // ปิดรับพรีออเดอร์
  estimatedShipAt DateTime?                  // กำหนดจัดส่งโดยประมาณ
  preorderNote    String?   @db.Text         // เงื่อนไข/รอบผลิต บอกผู้ซื้อก่อนตัดสินใจ

  // วิธีรับของที่สินค้านี้อนุญาต
  allowPickup   Boolean @default(true)
  allowShipping Boolean @default(true)

  // จำกัดจำนวนต่อออเดอร์ — กันคนกวาดของทั้งล็อต
  maxPerOrder Int @default(10)

  sortOrder Int @default(0)

  variants   ProductVariant[]
  images     ProductImage[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, type])
  @@index([eventId])
}

/**
 * ตัวเลือกของสินค้า เช่น ไซส์เสื้อ
 *
 * สินค้าทุกตัวต้องมีอย่างน้อย 1 variant — ของที่ไม่มีไซส์ให้สร้างตัวชื่อ "มาตรฐาน"
 * เพื่อให้ราคา/สต็อก/ตะกร้าใช้ตรรกะเดียวกันหมด และเลี่ยงปัญหา MySQL ที่ยอมให้
 * ค่า NULL ซ้ำกันได้ใน unique index (ถ้าปล่อยให้ variantId เป็น null ในตะกร้า)
 */
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String                  // เช่น "M (รอบอก 38 นิ้ว)" หรือ "มาตรฐาน"
  sku       String? @unique
  price     Float?                  // null = ใช้ราคาของสินค้า
  stock     Int?                    // null = ไม่จำกัด (ใช้กับพรีออเดอร์) / 0 = หมด
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name])
  @@index([productId])
}

model ProductImage {
  id        String               @id @default(cuid())
  productId String
  url       String
  caption   String?
  category  ProductImageCategory @default(OTHER)
  sortOrder Int                  @default(0)

  // ขนาดจริงของไฟล์ — จองพื้นที่ก่อนรูปโหลด กันหน้ากระโดด (เหมือน EventImage)
  width  Int?
  height Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([productId, category])
}

/** ตะกร้าค้างไว้ได้ข้ามเครื่อง เพราะผูกกับบัญชี ไม่ได้เก็บใน localStorage */
model Cart {
  id     String @id @default(cuid())
  userId String @unique

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int    @default(1)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
}

model Order {
  id      String      @id @default(cuid())
  orderNo String      @unique          // เลขที่อ่านง่ายสำหรับคุยกับลูกค้า เช่น RL-260906-0007
  userId  String
  status  OrderStatus @default(PENDING)
  type    ProductType                  // ออเดอร์ใบนี้เป็นของพร้อมส่ง หรือ พรีออเดอร์

  // ยอดทั้งหมดเป็น snapshot ณ เวลาสั่ง — ห้ามคำนวณใหม่จากราคาสินค้าปัจจุบัน
  // เพราะแอดมินแก้ราคาทีหลังได้ ออเดอร์เก่าต้องคงยอดเดิมไว้เป็นหลักฐาน
  subtotal    Float
  shippingFee Float
  total       Float

  deliveryMethod ShopDelivery

  // ที่อยู่จัดส่ง — snapshot เช่นกัน (ผู้ซื้อแก้โปรไฟล์ทีหลังไม่ควรกระทบใบเก่า)
  recipientName  String?
  recipientPhone String?
  address        String? @db.Text
  province       String?
  postalCode     String?
  customerNote   String? @db.Text

  // ต้องชำระให้เสร็จภายในเวลานี้ ไม่งั้นระบบคืนสต็อก (null = จ่ายแล้ว/จบแล้ว)
  expiresAt DateTime?
  paidAt    DateTime?

  // ร่องรอยการจ่ายผ่าน Stripe — ชุดเดียวกับ Registration ไว้ reconcile ย้อนหลัง
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  paymentMethod         String? // "card" | "promptpay"
  receiptUrl            String? @db.Text

  // การจัดส่ง/รับของ
  trackingNo String?
  shippedAt  DateTime?
  pickedUpAt DateTime?
  adminNote  String?   @db.Text

  // เวลาที่ผู้ซื้อกดยินยอม PDPA (ที่อยู่จัดส่งเป็นข้อมูลส่วนบุคคล)
  pdpaConsentAt DateTime?

  /**
   * ตั้งค่าเมื่อ Stripe แจ้งว่าจ่ายเงินสำเร็จ แต่ออเดอร์ไม่อยู่ในสถานะ PENDING แล้ว
   * (หมดเวลาชำระ หรือถูกยกเลิกไปก่อน — สต็อกถูกคืนให้คนอื่นไปแล้ว)
   *
   * เคสนี้เงินเข้าจริงแต่ลูกค้าไม่ได้ของ ห้ามปล่อยเงียบ ต้องมีคนตามเรื่อง
   * จึงบันทึกไว้ให้หน้าแอดมินเด้งเตือน พร้อมเก็บ payment intent ไว้ใช้คืนเงิน/ตามรอย
   */
  paymentIssueAt DateTime?

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([status, expiresAt])
  @@index([paymentIssueAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  // SetNull เพราะลบสินค้าออกจากร้านแล้ว ออเดอร์เก่าต้องยังอ่านได้อยู่
  productId String?
  variantId String?

  // snapshot ณ เวลาสั่ง — ชื่อและราคาต้องไม่เปลี่ยนตามสินค้าปัจจุบัน
  productName String
  variantName String
  unitPrice   Float
  quantity    Int
  lineTotal   Float

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

/** ตั้งค่าร้าน — มีแถวเดียวเสมอ (id = "default") แอดมินแก้ได้ในหน้าตั้งค่า */
model ShopSetting {
  id                   String  @id @default("default")
  shippingBaseFee      Float   @default(55)  // ค่าส่งชิ้นแรก
  shippingExtraPerItem Float   @default(10)  // ชิ้นถัดไปบวกชิ้นละ
  pickupLocation       String? @db.Text      // จุดรับของ แสดงตอนเลือก "รับเอง"
  announcement         String? @db.Text      // ประกาศบนหน้าร้าน

  updatedAt DateTime @updatedAt
}
